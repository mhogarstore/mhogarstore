# Copiar como .env para probar en local (netlify dev). En Netlify se ponen en
# Site configuration → Environment variables. NUNCA subir el .env a GitHub.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=clave-service-role-secreta

# Stripe → Developers → API keys (empezar con las de prueba: sk_test_…)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Developers → Webhooks → el endpoint /api/stripe-webhook → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Dirección pública de la web (sin barra final). Netlify rellena URL solo, esto la sustituye.
SITE_URL=https://mhogarstore.com

# Envío a domicilio, en céntimos. Deben coincidir con public/config.js
SHIP_COST_CENTS=2500
SHIP_FREE_FROM_CENTS=8000
